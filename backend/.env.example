# ============================================================================
#  «Пространство для двоих» — backend environment
#  Скопируйте этот файл в backend/.env и заполните значения. .env не коммитить.
#  Backend валидирует переменные через Zod при старте и падает с понятным
#  сообщением, если критичная переменная отсутствует или имеет неверный формат.
# ============================================================================

# --- Сервер -----------------------------------------------------------------
# development | production | test
NODE_ENV=development
PORT=3000
# 0.0.0.0 — слушать все интерфейсы (нужно для контейнеров/прокси)
HOST=0.0.0.0
# Список разрешённых origin через запятую. https://web.telegram.org добавляется автоматически.
CORS_ORIGINS=http://localhost:5173,https://your-frontend.example.com
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# --- Telegram ---------------------------------------------------------------
TELEGRAM_BOT_TOKEN=123456789:AAExampleTelegramBotToken
# Username бота без @ — из него собирается invite-ссылка
TELEGRAM_BOT_USERNAME=space_for_two_bot
# polling — локальная разработка; webhook — прод (требует HTTPS)
BOT_MODE=polling
# Публичный HTTPS-адрес backend без слэша на конце (для setWebhook). Обязателен при BOT_MODE=webhook.
PUBLIC_BASE_URL=
# Секрет для заголовка X-Telegram-Bot-Api-Secret-Token. Обязателен при BOT_MODE=webhook.
TELEGRAM_WEBHOOK_SECRET=
# Максимальный возраст initData в секундах (по умолчанию сутки)
INIT_DATA_MAX_AGE_SECONDS=86400
# URL Telegram Mini App (https, без слэша на конце)
MINI_APP_URL=https://your-frontend.example.com
# Обязательная подписка на канал. По умолчанию @naparulove.
# Бот должен быть администратором канала. Значение `off` отключает проверку.
TELEGRAM_REQUIRED_CHANNEL=@naparulove
# Публичная ссылка на канал (если не задана — https://t.me/<username без @>)
TELEGRAM_CHANNEL_URL=https://t.me/naparulove

# --- Supabase ---------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example.anon
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example.service
# Секрет HS256-ключа, которым backend подписывает Realtime-JWT (2 часа).
SUPABASE_JWT_SECRET=super-secret-jwt-secret
# ID (kid) этого ключа в Supabase → Settings → JWT Signing Keys. Если ключ
# импортирован как standby/in_use, укажите его UUID.
SUPABASE_JWT_KID=

# --- TMDB (опционально) -----------------------------------------------------
# Можно указать любой из двух: api key (v3) или access token (v4 bearer).
# Без них каталог фильмов собирается из локального fallback (src/data/movies.json).
TMDB_API_KEY=
TMDB_ACCESS_TOKEN=

# --- Платежи (обязательные) -------------------------------------------------
# HMAC-секрет подписи payload Telegram Stars. Не короче 16 символов.
PAYMENT_SIGNING_SECRET=change-me-to-a-long-random-string
# Цены в рублях. Только здесь — в коде они не хардкодятся.
PRICE_MONTHLY_RUB=149
PRICE_YEARLY_RUB=1299
# Цена в звёздах Telegram Stars (XTR).
STARS_MONTHLY=85
STARS_YEARLY=750

# --- Cron -------------------------------------------------------------------
# Секрет заголовка X-Cron-Secret для POST /api/cron/tick. Пусто — endpoint отвечает 503.
CRON_SECRET=
# Встроенный планировщик (напоминания раз в минуту, подписки раз в час). true/false
ENABLE_INTERNAL_CRON=true
